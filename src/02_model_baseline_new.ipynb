    "# 3. EXPLORE TARGET VARIABLE\\n",
    "print(\\\"\\\\n2️⃣ Analyzing target variable...\\\")\\n",
    "target_balance = df['Target'].mean()\\n",
    "print(f\\\"🎯 Target distribution:\\\")\\n",
    "print(f\\\"   - Class 0 (Down/No move): {(1-target_balance)*100:.1f}%\\\")\\n",
    "print(f\\\"   - Class 1 (Up): {target_balance*100:.1f}%\\\")\\n",
    "\\n",
    "# Check for class imbalance\\n",
    "if abs(target_balance - 0.5) > 0.15:\\n",
    "    print(\\\"⚠️  Significant class imbalance detected - will use SMOTE\\\")\\n",
    "else:\\n",
    "    print(\\\"✅ Reasonable class balance\\\")\\n",
    "\\n",
    "# Plot target distribution\\n",
    "plt.figure(figsize=(8, 6))\\n",
    "df['Target'].value_counts().plot(kind='bar', color=['skyblue', 'lightcoral'])\\n",
    "plt.title('Target Variable Distribution', fontsize=16, fontweight='bold')\\n",
    "plt.xlabel('Target Class (0=Down, 1=Up)', fontsize=12)\\n",
    "plt.ylabel('Count', fontsize=12)\\n",
